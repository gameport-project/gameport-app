<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- A test build only (see DebugBridgeReceiver): it is reachable from a cable, which is the whole point, so it never
             goes into a release. Nothing it does is beyond what the player can do from the screen. -->
        <receiver
            android:name=".debug.DebugBridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.gameport.DEBUG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
