<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Development only: lets adb ask the running app what Steam Cloud holds for a game. -->
        <receiver
            android:name="app.gameport.debug.CloudDebugReceiver"
            android:exported="true" />
        <receiver
            android:name="app.gameport.debug.PatchDebugReceiver"
            android:exported="true" />
        <!-- Development only: shows the news window of a version, with made-up games. -->
        <receiver
            android:name="app.gameport.debug.WhatsNewPreviewReceiver"
            android:exported="true" />
        <!-- Development only: reads what Steam publishes for a game (depots, branches, files of a depot). -->
        <receiver
            android:name="app.gameport.debug.SteamInspectReceiver"
            android:exported="true" />
        <!-- Development only: tests whose files a game's expansion folder holds, by copying them anew. -->
        <receiver
            android:name="app.gameport.debug.ObbRepairReceiver"
            android:exported="true" />
        <!-- Development only: puts the question "did it work?" for a game, without playing it. -->
        <receiver
            android:name="app.gameport.debug.VerdictAskReceiver"
            android:exported="true" />
        <!-- Development only: puts the question about another device that plays, without one. -->
        <receiver
            android:name="app.gameport.debug.PlaySimulationReceiver"
            android:exported="true" />
        <!-- Development only: downloads a game as Steam sells it, without patching or installing it. -->
        <receiver
            android:name="app.gameport.debug.OriginalDownloadReceiver"
            android:exported="true" />
        <!-- Development only: works out (and, when asked, really does) the adding of achievements to the Steam account. -->
        <receiver
            android:name="app.gameport.debug.AchievementDebugReceiver"
            android:exported="true" />
    </application>

</manifest>
