        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="640"
                android:endY="360"
                android:startColor="#FF222932"
                android:endColor="#FF3C4C7A" />
        </aapt:attr>
    </path>
    <group android:translateX="164.32" android:translateY="24.32" android:scaleX="0.6081" android:scaleY="0.6081">
        <path
            android:pathData="M348.2,173 A124,124 0 1 0 380,256 L272,256"
            android:strokeColor="#FFF5F5F7"
            android:strokeWidth="48"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <group android:translateX="-12">
