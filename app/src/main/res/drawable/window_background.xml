<?xml version="1.0" encoding="utf-8"?>
<!-- What shows before the first screen is drawn: the logo on the gradient the pages sit on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF222932"
                android:endColor="#FF3C4C7A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/gameport_logo" />
</layer-list>
