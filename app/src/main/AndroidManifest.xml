<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To know whether the device has a network when a game ends (a normal permission: nothing is asked on the screen). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- PICO 4 Ultra (Android 14) requires user-granted special access for Android/obb writes. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".GamePortApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GamePort">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The Workshop page of a game, as a game's own "browse" button asks for it: it opens here, in the application. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="steamcommunity.com" />
                <data android:host="www.steamcommunity.com" />
                <data android:pathPattern="/app/.*/workshop.*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
