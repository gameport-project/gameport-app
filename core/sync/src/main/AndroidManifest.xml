<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- What patched games call at launch and while playing; each call is checked against the
             package name Android reports for the caller. -->
        <provider
            android:name=".CloudProvider"
            android:authorities="app.gameport.cloud"
            android:exported="true" />

        <!-- Told when the player removes the notification of an achievement (nothing outside GamePort may send to it). -->
        <receiver
            android:name=".AchievementDismissReceiver"
            android:exported="false" />
    </application>

</manifest>
