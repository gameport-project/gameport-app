    <string name="settings_hero_title_description">A pill with the name of the game and a play icon appears above the cover being pointed at; pressing it starts the game. Off: the room kept for it above the covers is removed.</string>
    <string name="settings_pill_size">Pill size</string>
    <string name="settings_pill_size_description">The size of the name above the highlighted cover, and the room kept for it.</string>
