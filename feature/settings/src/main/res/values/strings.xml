    <string name="settings_hover_description">Full: the cover zooms and a ring drifts out around it. Reduced: no zoom or drift. None: the ring just appears.</string>
    <string name="settings_accent">Accent colour</string>
    <string name="settings_category_home">Home</string>
    <string name="settings_home_description">What the home shows above and between the rows of covers. Each can be switched off to keep the page light.</string>
