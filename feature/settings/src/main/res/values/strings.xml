    <string name="settings_games_description">What every game uses when seated mode is on. A game that has its own setting keeps it.</string>
    <string name="settings_games_height">Height: %1$d cm</string>
    <string name="settings_games_height_description">Each game can override this from its own settings, and go back to this value with one button.</string>
    <string name="settings_category_appearance">Appearance</string>
    <string name="settings_backdrop">Game artwork in the background</string>
    <string name="settings_backdrop_description">Shows the artwork of the selected game behind the library.</string>
